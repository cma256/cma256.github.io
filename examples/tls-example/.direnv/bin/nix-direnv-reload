#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/colton/Code/cma256.github.io/examples/tls-example" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/colton/Code/cma256.github.io/examples/tls-example")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/colton/Code/cma256.github.io/examples/tls-example" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/colton/Code/cma256.github.io/examples/tls-example/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/colton/Code/cma256.github.io/examples/tls-example/.envrc" "/Users/colton/Code/cma256.github.io/examples/tls-example/.direnv"/*.rc
